<?xml version="1.0" ?>
<robot name="roarm_m2" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Declared here: this file is also an entry for roarm_description/display.launch.py -->
<xacro:arg name="add_depth_camera" default="false"/>
<!-- M2 depth-camera mount not designed yet; arg kept for launch compatibility. -->

<xacro:arg name="add_camera" default="false"/>
<xacro:property name="add_camera" value="$(arg add_camera)"/>

<xacro:arg name="GZ_VERSION" default="classic"/>
<xacro:property name="GZ_VERSION" value="$(arg GZ_VERSION)"/>

<xacro:arg name="gripper_type" default="angular_gear"/>
<xacro:property name="gripper_type" value="$(arg gripper_type)"/>

<xacro:include filename="$(find roarm_description)/urdf/materials.xacro" />
<xacro:include filename="$(find roarm_description)/urdf/gazebo/roarm_m2.trans" />
<xacro:include filename="$(find roarm_description)/urdf/gazebo/roarm_m2.gazebo" />

<xacro:if value="${add_camera}">
<xacro:include filename="$(find roarm_description)/urdf/camera/camera.xacro" />
<xacro:include filename="$(find roarm_description)/urdf/camera/camera.gazebo.xacro" />
<xacro:cam use_gazebo="true">

  <xacro:if value="${gripper_type == 'angular_direct'}">
    <parent link="link3" />
    <origin xyz="-0.062588 -0.181612 0" rpy="1.5708 0 -1.3963" />
  </xacro:if>

  <xacro:if value="${gripper_type == 'angular_gear'}">
    <parent link="link3" />
    <!-- <origin xyz="-0.046 -0.183536 0" rpy="1.5708 0 -1.5708" /> -->
    <origin xyz="-0.020898 -0.239246 0" rpy="1.5708 0 -1.5708" />
    <!-- usb cam in hand -->
  </xacro:if>

    <!-- <parent link="base_link" />
    <origin xyz="0.06531 0 0.021953" rpy="0 0 0" /> -->
    <!-- usb cam out hand -->
  </xacro:cam>  
</xacro:if>

<link name="world"></link>

<link name="base_link">
  <inertial>
    <origin xyz="0.0032 0 0.0417" rpy="0 0 0" />
    <mass value="0.2562183" />
    <inertia ixx="0.00029211" ixy="0" ixz="0" iyy="0.00035719" iyz="0" izz="0.000349421" />
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m2/base_link.stl"  scale="1.0 1.0 1.0"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m2/base_link.stl"  scale="1.0 1.0 1.0"/>
    </geometry>
  </collision>
</link>

<link name="link1">
  <inertial>
    <origin xyz="0 0 -0.015" rpy="0 0 0" />
    <mass value="0.0729177" />
    <inertia ixx="4.68465E-05" ixy="0" ixz="0" iyy="3.32107E-05" iyz="0" izz="5.01023E-05" />
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry> 
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m2/link1.stl"  scale="1.0 1.0 1.0"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m2/link1.stl"  scale="1.0 1.0 1.0"/>
    </geometry>
  </collision>
</link>

<link name="link2">
  <inertial>
    <origin xyz="0.11841 0.012245 0" rpy="0 0 0" />
    <mass value="0.0703216" />
    <inertia ixx="5.46501E-05" ixy="0" ixz="0" iyy="0.000423091" iyz="0" izz="0.000404557" />
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m2/link2.stl"  scale="1.0 1.0 1.0"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m2/link2.stl"  scale="1.0 1.0 1.0"/>
    </geometry>
  </collision>
</link>

<link name="link3">
  <inertial>
    <origin xyz="-0.0015735 -0.083617 -0.00085" rpy="0 0 0" />
    <mass value="0.0181535" />
    <inertia ixx="5.50661E-05" ixy="0" ixz="0" iyy="3.08352E-06" iyz="0" izz="5.43323E-05" />
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m2/link3.stl"  scale="1.0 1.0 1.0"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <mesh filename="file://$(find roarm_description)/meshes/roarm_m2/link3.stl"  scale="1.0 1.0 1.0"/>
    </geometry>
  </collision>
</link>

<link name="hand_tcp"></link>

<joint name="world_to_base_link" type="fixed">
  <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  <parent link="world"/>
  <child link="base_link"/>
  <axis xyz="0.0 0.0 1.0"/>
</joint>  
  
<joint name="base_link_to_link1" type="revolute">
  <origin xyz="0.0100000008759151 0 0.123059270461044" rpy="0 0 0" />
  <parent link="base_link" />
  <child link="link1" />
  <axis xyz="0 0 1" />
  <limit lower="-3.1416" upper="3.1416" effort="20" velocity="3.14" />
</joint>

<joint name="link1_to_link2" type="revolute">
  <origin xyz="0 0 0" rpy="-1.5708 -1.5708 0" />
  <parent link="link1" />
  <child link="link2" />
  <axis xyz="0 0 1" />
  <limit lower="-1.5708" upper="1.5708" effort="20" velocity="3.14" />
</joint>

<joint name="link2_to_link3" type="revolute">
  <origin xyz="0.236774 0.0300023995170449 0" rpy="0 0 1.5708" />
  <parent link="link2" />
  <child  link="link3" />
  <axis xyz="0 0 1" />
  <limit lower="0" upper="2.95" effort="20" velocity="3.14" />
</joint>

<xacro:if value="${gripper_type == 'angular_direct'}">
  <xacro:include filename="$(find roarm_description)/urdf/gripper/gripper.xacro" />
  <joint name="link3_to_gripper_base" type="fixed">
    <origin xyz="0.002906 -0.21599 -0.00066683" rpy="1.5708 0 -1.5708" />
    <parent link="link3" />
    <child link="gripper_base" />
    <axis xyz="0 0 1" />
  </joint>
</xacro:if>

<xacro:if value="${gripper_type == 'angular_gear'}">
  <xacro:include filename="$(find roarm_description)/urdf/gripper/gripper_a.xacro" />
  <joint name="link3_to_gripper_base" type="fixed">
    <origin xyz="-0.002998 -0.186601 -0.000835" rpy="1.5708 0 -1.5708" />
    <parent link="link3" />
    <child link="gripper_base" />
    <axis xyz="0 0 1" />
  </joint>
</xacro:if>
  
</robot>
