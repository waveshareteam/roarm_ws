<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

<!-- GZ_VERSION comes from the entry urdf.xacro (ugv_roarm / roarm_moveit). -->

<!-- Gazebo Classic -->
<xacro:if value="${GZ_VERSION == 'classic'}">
<gazebo reference="oak_base_hand">
  <sensor name="oak" type="depth">
    <always_on>true</always_on>
    <visualize>true</visualize>
    <update_rate>30</update_rate>
    <camera name="oak">
      <horizontal_fov>1.2</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.02</near>
        <far>8</far>
      </clip>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.007</stddev>
      </noise>
    </camera>
    <plugin name="oak_camera_driver" filename="libgazebo_ros_camera.so">
      <ros>
      </ros>
      <min_depth>0.01</min_depth>
      <max_depth>8.0</max_depth>
      <frame_name>depth_camera_link</frame_name>
    </plugin>
  </sensor>
</gazebo>
</xacro:if>

<!-- Gazebo Harmonic (images via ros_gz_bridge) -->
<xacro:if value="${GZ_VERSION == 'harmonic'}">
<gazebo reference="oak_base_hand">
  <sensor name="hand_oak" type="rgbd_camera">
    <gz_frame_id>depth_camera_link</gz_frame_id>
    <topic>hand_oak</topic>
    <update_rate>30</update_rate>
    <always_on>true</always_on>
    <visualize>true</visualize>
    <camera>
      <horizontal_fov>1.2</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
      </image>
      <clip>
        <near>0.02</near>
        <far>8.0</far>
      </clip>
      <depth_camera>
        <clip>
          <near>0.02</near>
          <far>8.0</far>
        </clip>
      </depth_camera>
    </camera>
  </sensor>
</gazebo>
</xacro:if>

</robot>
